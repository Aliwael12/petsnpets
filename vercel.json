{
  "installCommand": "npm install && npm install --prefix server",
  "buildCommand": "npm run build --prefix server && npm run build",
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 15,
      "includeFiles": "../server/node_modules/pdfkit/**"
    }
  },
  "rewrites": [
    { "source": "/v1/(.*)", "destination": "/api" },
    { "source": "/((?!assets/|logo\\.jpeg|favicon).*)", "destination": "/index.html" }
  ]
}
