# Local Supabase stack (started via `npx supabase start` from the repo root).
# These are Supabase's fixed, publicly-documented local-dev defaults — identical on every
# machine — not secrets. Never reuse them for a real deployment.
NODE_ENV=development
PORT=3001

# Postgres — session-mode connection, used by the Nest runtime pool
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
# Same DB locally; kept as a separate var so migrations always target the direct connection
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Operator PIN session tokens are signed by Nest itself (separate from Supabase Auth JWTs).
# Regenerate for any real deployment: `openssl rand -hex 32`
OPERATOR_JWT_SECRET=local-dev-operator-secret-change-me-1234567890abcdef
OPERATOR_SESSION_TTL_HOURS=12

INVOICE_BUCKET=invoices
TIMEZONE=Africa/Cairo
